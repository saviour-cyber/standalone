# Environment Configuration

NODE_ENV=development
PORT=3000

# Neon Postgres Connection URL (get this from your Neon console at console.neon.tech)
# Example: postgresql://neondb_owner:password@ep-cold-pond-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# Redis (optional in dev, required in prod)
REDIS_URL=redis://localhost:6379

# JWT Secrets (generate strong random keys in production, minimum 32 chars)
JWT_SECRET=dev_jwt_secret_key_needs_to_be_at_least_32_characters_long
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_needs_to_be_at_least_32_characters_long

# Financial Mode
REAL_MONEY_ENABLED=false
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_ENV=sandbox
